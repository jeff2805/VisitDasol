<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
            Pinned, like the database below, so the suite does not depend
            on where this machine happens to serve the site from.

            APP_URL is http://localhost/visitdasol/public in development,
            because that is genuinely where XAMPP serves it. route() builds
            on that, so without this override every $this->get(route(...))
            would ask the test kernel for /visitdasol/public/resorts/... —
            a path no route matches — and the whole suite would 404.
        -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!--
            No sign-in code during the tests.

            The site asks for one on every sign-in; see
            visitdasol.otp.require_on_login. A test about room availability or
            an Excel column has no business reading a code out of a mailbox to
            get through the door, and thirty-odd tests sign in with a password
            to reach the thing they are really about.

            The tests that ARE about the sign-in code switch it back on
            themselves, so the two-step flow is still covered — see
            tests/Feature/Auth/LoginOtpTest.php.
        -->
        <env name="AUTH_LOGIN_OTP" value="false"/>
        <!--
            No payment gateway unless a test asks for one.

            These used to fall through to .env, so whether a test passed
            depended on whether the developer running it happened to have a
            PayMongo key configured. Two tests about Manual GCash being the
            ONLY method on offer broke the day a real key was added to a
            laptop — the code was fine; the suite was reading the room.

            Pinned empty here, which is what the rest of this file does for
            the database and the mail. The payment tests switch a gateway on
            themselves with config([...]) in their own setUp.
        -->
        <env name="PAYMONGO_SECRET_KEY" value=""/>
        <env name="PAYMONGO_WEBHOOK_SECRET" value=""/>
        <env name="PAYMONGO_METHODS" value="qrph"/>
        <env name="PAYPAL_CLIENT_ID" value=""/>
        <env name="PAYPAL_SECRET" value=""/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            The test database is pinned in full, not just by name.

            DB_CONNECTION and DB_DATABASE used to be the only overrides,
            and the host, port and credentials fell through to .env. That
            was harmless while .env also pointed at local MariaDB. The
            moment .env was switched to Supabase, the suite began asking
            the MySQL driver to reach a PostgreSQL pooler on port 5432 —
            and because that combination does not fail fast, the whole
            run hung with no output rather than reporting an error.

            Tests belong on the local database whatever .env is doing.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="visitdasol_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="DB_SSLMODE" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
