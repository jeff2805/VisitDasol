APP_NAME="Visit Dasol"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://visitdasol.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# XAMPP ships MariaDB; Laravel's mysql driver works with it.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=visitdasol
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# Set to true once the site is served over HTTPS, so the session cookie is never sent unencrypted.
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# No email in v1 (Decision 6): messages are written to storage/logs/laravel.log
# Password reset emails.
# log  = emails are written to storage/logs/laravel.log (development default;
#        open the log and copy the "Choose a new password" link).
# smtp = real sending. For Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
#        MAIL_SCHEME=null, MAIL_USERNAME=the Gmail address, and MAIL_PASSWORD
#        set to a Google "app password" (not the normal account password).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@visitdasol.test"
MAIL_FROM_NAME="${APP_NAME}"

# Municipal Tourism Office contact details shown in the site footer (optional)
MTO_CONTACT_PHONE=
MTO_CONTACT_EMAIL=
MTO_CONTACT_FACEBOOK_URL=

# First MTO (super admin) account, created by: php artisan db:seed
# Password: 12+ characters with upper- and lowercase letters and a number.
MTO_ADMIN_FIRST_NAME=Tourism
MTO_ADMIN_LAST_NAME=Office
MTO_ADMIN_EMAIL=mto@visitdasol.test
MTO_ADMIN_PHONE=
MTO_ADMIN_PASSWORD=

# Fictional demo data for development and capstone demonstrations only.
SEED_DEMO_DATA=true
DEMO_ACCOUNT_PASSWORD=
